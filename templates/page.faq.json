    "accordion_eyUJfJ": {
      "type": "accordion",
      "blocks": {
        "text_BQma8b": {
          "type": "text",
          "settings": {
            "heading": "What is Doggyji?",
            "description": "<p>Doggyji is a reputed brand offering nutritious and <a href=\"https://www.doggyji.com/\">affordable food for dogs</a>. Since our launch in January 2023, we’ve been on a mission to serve pet owners and stray dog feeders with healthy alternatives to glucose biscuits.</p>"
          }
        },
        "text_LxPFF4": {
          "type": "text",
          "settings": {
            "heading": "What makes Doggyji products unique?",
            "description": "<p>Doggyji stands out by offering high-quality, nutritious, and affordable dog food. Every recipe is developed after extensive research and in consultation with veterinary experts across India, ensuring our treats are safe and healthy for all dogs.</p>"
          }
        },
        "text_RjjKmT": {
          "type": "text",
          "settings": {
            "heading": "Are Doggyji products suitable for stray dogs?",
            "description": "<p>Absolutely! <a href=\"https://www.doggyji.com/all-products/\">Doggyji products</a> are crafted for all dogs, including strays. Our affordable pricing ensures dog lovers can feed stray dogs without compromising on quality.</p>"
          }
        },
        "text_TdYqwY": {
          "type": "text",
          "settings": {
            "heading": "What is V-Bite?",
            "description": "<p>V-Bite is our <a href=\"https://www.doggyji.com/shop/doggy-ji-biscuits/doggy-ji-v-bite-vegan-biscuits-48-packs/\">100% vegan biscuit for dogs</a>, made from plant-based ingredients. It’s a nutritious treat designed to keep your dogs healthy and happy.</p>"
          }
        },
        "text_h9QhQh": {
          "type": "text",
          "settings": {
            "heading": "Are Doggyji products suitable for all breeds?",
            "description": "<p>Yes, Doggyji products are specially formulated to meet the nutritional needs of dogs of all breeds and sizes</p>"
          }
        },
        "text_zBTzHY": {
          "type": "text",
          "settings": {
            "heading": "Do Doggyji products contain preservatives or artificial additives?",
            "description": "<p>No, our products are free from harmful preservatives and artificial additives. We focus on natural, high-quality ingredients to keep your dog healthy.</p>"
          }
        },
        "text_pC8MA9": {
          "type": "text",
          "settings": {
            "heading": "Are Doggyji products safe for puppies?",
            "description": "<p>Yes, Doggyji treats are suitable for dogs of all ages, including puppies. Just ensure you follow the feeding guidelines based on your puppy’s age and size.</p>"
          }
        },
        "text_AfEDTq": {
          "type": "text",
          "settings": {
            "heading": "Is there a subscription service for regular deliveries?",
            "description": "<p>Not yet, but we’re working on it! Stay tuned for updates on our upcoming subscription service.</p>"
          }
        },
        "text_WT4Xde": {
          "type": "text",
          "settings": {
            "heading": "Does Doggyji support any social initiatives?",
            "description": "<p>Yes, Doggyji is deeply committed to helping stray dogs. We promote feeding strays and make it easier with our affordable, nutritious products.</p>"
          }
        }
      },
